{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "V34 Modem",
  "version": "0.1.9",
  "identifier": "fr.tinyverse.v34modem",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "V.34 // Tinyverse Modem",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "backgroundColor": "#14110f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi", "deb", "appimage"],
    "publisher": "Leizar06001",
    "homepage": "https://github.com/Leizar06001/dialup",
    "copyright": "Copyright © 2026 Leizar06001",
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "Modem logiciel V.34 audible, façon années 90",
    "longDescription": "Modem logiciel V.8 / V.34 / V.90 qu'on entend négocier, dans une interface rétro : simulateur de ligne téléphonique, console AT, appels entre abonnés par un central téléphonique sur IP, accès Internet par modem jusqu'à 56 kbit/s (56K) avec un navigateur « web 1998 », messagerie et visiophone entre abonnés, et le 3615 ORACLE.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": ["libasound2"],
        "recommends": ["gstreamer1.0-plugins-good", "gstreamer1.0-pipewire"]
      }
    }
  }
}
