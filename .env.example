# Réglages du site d'inscription (copier en .env, chmod 600).

# Adresse publique du site (sans / final) et nom du fournisseur d'accès
PORTAIL_URL=https://dialup.example.org
PORTAIL_NOM=Tinyverse Dialup
# Adresse du central à saisir dans l'appli (défaut : même hôte, port 3434)
#PORTAIL_CENTRAL=dialup.example.org:3434

# Administrateur : un abonné de /etc/v34-server/config.toml (page /admin
# avec son mot de passe), et l'adresse qui reçoit les demandes d'accès Internet
PORTAIL_ADMIN=
PORTAIL_ADMIN_COURRIEL=

# Dépôt GitHub des versions de l'appli (page de téléchargement)
PORTAIL_DEPOT=Leizar06001/dialup
# Inscriptions acceptées par adresse IP et par heure
PORTAIL_INSCRIPTIONS_PAR_HEURE=3
# error | warn | info | debug
PORTAIL_JOURNAL=info

# Envoi des e-mails (SMTP authentifié). SMTP_HOST vide : inscriptions fermées ;
# SMTP_HOST=journal : e-mails écrits dans le journal au lieu d'être envoyés (essais).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Tinyverse Dialup <contact@example.org>"
# vide : TLS direct si le port est 465, sinon STARTTLS ; true/false pour forcer
SMTP_SSL=

# Utilisateur du service v34-server (id -u v34 / id -g v34) et port local
V34_UID=987
V34_GID=987
PORTAIL_PORT=8034
